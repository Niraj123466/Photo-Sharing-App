# Environment Variables for Photo Sharing App
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# DATABASE (Neon PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─────────────────────────────────────────────
# AUTH.JS
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-super-secret-key-min-32-chars

# ─────────────────────────────────────────────
# Application URL (Use APP_URL or NEXT_PUBLIC_APP_URL)
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# CLOUDFLARE R2 (Object Storage)
# ─────────────────────────────────────────────
# Your Cloudflare account ID (from dash.cloudflare.com)
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API token credentials (create under R2 > API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Your R2 bucket name
R2_BUCKET_NAME=your-bucket-name

# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ─────────────────────────────────────────────
# UPLOAD SETTINGS
# ─────────────────────────────────────────────
# Max upload size in bytes (default 50MB)
MAX_UPLOAD_SIZE=52428800

# ─────────────────────────────────────────────
# GALLERY SESSION
# ─────────────────────────────────────────────
# Gallery session duration in seconds (default 1 hour)
GALLERY_SESSION_DURATION=3600

# ─────────────────────────────────────────────
# SEED / DEMO (for prisma/seed.ts only)
# ─────────────────────────────────────────────
SEED_ADMIN_PASSWORD=Admin@demo123
SEED_MEMBER_PASSWORD=Member@demo123
SEED_GALLERY_PIN=482917
